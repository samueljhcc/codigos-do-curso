import math

area = float(input("Digite a área a ser pintada em m²: "))

# Quantidade de litros necessária
litros = area / 6

# Acrescentando 10% de folga
litros = litros * 1.10


# -----------------------------------
# 1) Apenas latas de 18 litros
# -----------------------------------

latas = math.ceil(litros / 18)

preco_latas = latas * 80


# -----------------------------------
# 2) Apenas galões de 3,6 litros
# -----------------------------------

galoes = math.ceil(litros / 3.6)

preco_galoes = galoes * 25


# -----------------------------------
# 3) Misturando latas e galões
# -----------------------------------

melhor_latas = 0
melhor_galoes = 0
menor_desperdicio = float("inf")

for l in range(0, math.ceil(litros / 18) + 1):
    for g in range(0, math.ceil(litros / 3.6) + 1):

        total_litros = l * 18 + g * 3.6

        if total_litros >= litros:

            desperdicio = total_litros - litros

            if desperdicio < menor_desperdicio:
                menor_desperdicio = desperdicio
                melhor_latas = l
                melhor_galoes = g


preco_mistura = melhor_latas * 80 + melhor_galoes * 25


# -----------------------------------
# Resultados
# -----------------------------------

print("\n--- RESULTADOS ---")

print("1) Apenas latas:")
print("Latas:", latas)
print(f"Preço: R$ {preco_latas:.2f}")

print("\n2) Apenas galões:")
print("Galões:", galoes)
print(f"Preço: R$ {preco_galoes:.2f}")

print("\n3) Mistura:")
print("Latas:", melhor_latas)
print("Galões:", melhor_galoes)
print(f"Preço: R$ {preco_mistura:.2f}")